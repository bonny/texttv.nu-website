# Compose-env för den lokala Docker-stacken. Allt har defaults i compose.yaml,
# så .env är VALFRITT — kopiera bara hit (`cp .env.example .env`) om du vill
# avvika från standard.
#
# OBS: website-imagen har DB-creds (texttv/texttv) inbakade som fastcgi_param.
# Ändrar du DB_USERNAME/DB_PASSWORD här måste du bygga om webben: `make rebuild`.

APP_ENV=local
# Fast dev-nyckel (ingen hemlighet — bara för att slippa key:generate-steget).
APP_KEY=base64:evvx/iy4U9nmQvUIop3Zq5QKIx0jbdgjsOshyotQW44=

# Importerns publika adress. asset() bakar in den i block-grafikens URL:er
# (storage/chars/*.gif) vid import — måste vara importerns nåbara host:port,
# annars 404:ar grafiken. Byt om du mappar importern till en annan port.
APP_URL=http://localhost:8381

DB_DATABASE=texttv_nu
DB_USERNAME=texttv
DB_PASSWORD=texttv
DB_ROOT_PASSWORD=root
