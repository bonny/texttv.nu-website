.DS_Store

# Docker Compose: lokal env (kopia av .env.example, se CLAUDE.md)
/.env
.vscode/settings.json
importer/.vscode/settings.json
texttv.nu/.valet-env.php
texttv.nu/debug.txt

# Claude Code lokala settings + harness-state
.claude/settings.local.json
.claude/scheduled_tasks.lock
.playwright-mcp/

# Lighthouse-rapporter: HTML är stort och kan regenereras från JSON
# (öppna en JSON via `lighthouse --view ...report.json` eller fyll i URL på
# https://googlechrome.github.io/lighthouse/viewer/). JSON committas.
baselines/*/*.report.html

# API-kontraktstestets utdata (tests/api/run.sh)
/.api-test/

# PHPStan (make phpstan): verktyget installeras lokalt
/tools/phpstan/vendor/

# CodeIgniters cache (t.ex. /polisen) skrivs vid körning
/texttv.nu/codeigniter/application/cache/*
!/texttv.nu/codeigniter/application/cache/index.html

# Skrivs av deploy-website.yml, läses av /status.
texttv.nu/codeigniter/application/deploy.json
